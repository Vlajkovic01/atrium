# Keeps the build context small and keeps local state out of the image.
.git
.github
docs
**/node_modules
**/dist
**/bin
**/obj
**/TestResults
**/test-results
**/playwright-report
server/tests
web/e2e

# The image holds the server and the web app. Of the mobile app only the
# manifest is needed, so the workspace's lockfile matches.
mobile/*
!mobile/package.json

# Never part of an image: local runtime data, keys, databases, settings.
**/.atrium
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.*
!**/.env.example
