{
  "expo": {
    "name": "Atrium",
    "slug": "atrium",
    "version": "0.1.0",
    "scheme": "atrium",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.atrium.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c6b58"
      }
    },
    "ios": {
      "bundleIdentifier": "app.atrium.mobile",
      "supportsTablet": true
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
