# Copy this file to ".env" in the same folder and change what you need.
# Every line is optional; with no .env file Atrium starts with SQLite on
# port 8080.

# The port Atrium is reachable on from this machine's network.
#ATRIUM_PORT=8080

# Which release to run. "latest" follows new releases when you pull.
#ATRIUM_VERSION=latest

# Choose the setup token yourself (at least 16 characters) instead of
# reading it from "docker compose logs atrium". It is only used until the
# first admin account exists.
#ATRIUM_SETUP_TOKEN=

# Your time zone. Photos that do not record when they were taken, such as
# screenshots, are dated by their file time in this zone.
#TZ=Europe/Belgrade

# --- PostgreSQL instead of the built-in SQLite database ------------------
# Uncomment all four lines and choose a password. Use the same password in
# both places.
#COMPOSE_PROFILES=postgres
#POSTGRES_PASSWORD=change-me
#ATRIUM_DB_PROVIDER=postgres
#ATRIUM_DB_CONNECTION=Host=postgres;Database=atrium;Username=atrium;Password=change-me

# --- HTTPS with automatic certificates -----------------------------------
# Needs a domain name that points at this machine, and ports 80 and 443
# reachable from the internet. To use it together with PostgreSQL write
# COMPOSE_PROFILES=postgres,https
#COMPOSE_PROFILES=https
#ATRIUM_DOMAIN=cloud.example.com
